<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Overlay permission. This is the reliable route to the red screen-takeover
      alert (F26). USE_FULL_SCREEN_INTENT is deliberately NOT used: Android 14
      restricted it to calling and alarm apps by default, and even when granted
      it degrades to an ordinary heads-up notification on an unlocked device.
      SYSTEM_ALERT_WINDOW is a special access permission the user grants through
      Settings, which fits our setup flow where the adult child configures the
      phone once.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Backend calls for the deeper server-side pillars. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Posting our own alerts, and the self-test synthetic notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Asking to be exempted from battery optimisation (F43). Aggressive OEM
         process killing on budget Indian handsets is risk #3 in the PRD. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SatyaShieldApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SatyaShield"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SatyaShield">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Share-sheet target (F2). This is the ONLY path by which media can
          reach us: a notification carries text, not files, and WhatsApp media
          lives in scoped storage we cannot read. Passive media scanning is
          impossible, so every media check is an explicit user action.
        -->
        <activity
            android:name=".ui.ShareTargetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:noHistory="true"
            android:theme="@style/Theme.SatyaShield.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <!-- message/rfc822 is what mail apps use for "share email". -->
                <data android:mimeType="message/rfc822" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Passive message-text capture (F1). The entire product thesis rests on
          this service. It is bound by the system once the user grants
          notification access in Settings, so it needs no foreground service of
          its own and declares no foregroundServiceType.
        -->
        <service
            android:name=".service.SatyaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
